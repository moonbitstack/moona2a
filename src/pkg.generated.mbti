pub type Headers = Array[(String, String)]

// Traits
pub(open) trait EventSink {
  async fn emit(Self, StreamEvent) -> Unit
}

pub(open) trait Executor {
  async fn execute(Self, RequestContext, &EventSink) -> Unit
  async fn cancel(Self, String) -> Unit
}

pub(open) trait Notifier {
  async fn notify(Self, TaskPushConfig, StreamEvent) -> Unit
}

pub(open) trait ReplySink {
  async fn reply(Self, @moonjrpc.Message) -> Unit
}

pub(open) trait TaskStore {
  fn get(Self, String) -> Task?
  fn put(Self, Task) -> Unit
  fn all(Self) -> Array[Task]
  fn remove(Self, String) -> Unit
}

pub(open) trait Transport {
  async fn exchange(Self, @moonjrpc.Message) -> @moonjrpc.Message
  async fn stream(Self, @moonjrpc.Message, &ReplySink) -> Unit
  async fn discover(Self) -> @json.Json
  async fn exchange_with(Self, @moonjrpc.Message, Array[(String, String)]) -> @moonjrpc.Message = _
  async fn stream_with(Self, @moonjrpc.Message, &ReplySink, Array[(String, String)]) -> Unit = _
  async fn discover_with(Self, Array[(String, String)]) -> @json.Json = _
}
