// The two bindings over HTTP, JSON-RPC and HTTP+JSON, with the card at its well-known address,
// as an ASGI application any server can drive.

import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/string",
  "moonbitstack/moona2a",
  "moonbitstack/moonasgi",
  "moonbitstack/moonasgi/spec",
  "moonbitstack/moonjrpc",
  "moonbitstack/moonjson",
  "moonbitstack/moonurl",
}

import {
  "moonbitlang/async",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitstack/moona2a",
  "moonbitstack/moonasgi",
  "moonbitstack/moonasgi/spec",
  "moonbitstack/moonhttp/sse",
} for "test"
