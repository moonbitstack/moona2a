// Both sides of one exchange, instrumented, with the spans exported over OTLP/gRPC. A
// collector that understands the semantic conventions decides whether what arrived says
// what the conventions say it should: that is what the conformance job runs this for.

pkgtype(kind: "executable")

// gRPC is HTTP/2 over a TCP connection, and the channel underneath is a socket: the
// native backend is the only one with those.

supported_targets = "+native"

import {
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitstack/moona2a",
  "moonbitstack/moona2a/otel",
  "moonbitstack/moonjrpc",
  "moonbitstack/moonjson",
  "moonbitstack/moonseed",
  "moonbitstack/moonseed/system",
  "moonbitstack/moontel/otlp",
  "moonbitstack/moontel/otlp/binary",
  "moonbitstack/moontel/otlp/grpc",
  "moonbitstack/moontel/trace",
}
