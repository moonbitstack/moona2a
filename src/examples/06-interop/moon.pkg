// Calls an agent that is already running, over the binding named on the command line, and checks
// what comes back. Native only: it needs sockets.

import {
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitstack/moona2a",
  "moonbitstack/moona2a/fetch",
  "moonbitstack/moona2a/grpc/channel",
  "moonbitstack/moonjrpc",
}

supported_targets = "+native"

pkgtype(kind: "executable")
