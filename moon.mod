name = "moonbitstack/moona2a"

version = "0.2.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moona2a"

license = "Apache-2.0"

keywords = [
  "a2a",
  "agent2agent",
  "agent",
  "agents",
  "protocol",
  "json-rpc",
  "jsonrpc",
  "sse",
  "server-sent-events",
  "agent-card",
  "well-known",
  "task",
  "artifact",
  "streaming",
  "push-notification",
  "webhook",
  "multi-agent",
  "interop",
  "opentelemetry",
  "otel",
  "otlp",
  "tracing",
  "telemetry",
  "observability",
  "span",
  "gen-ai",
  "semantic-conventions",
  "request-headers",
  "headers",
  "traceparent",
  "w3c-trace-context",
  "context-propagation",
  "concurrency",
  "multi-task",
  "moonbit",
]

description = "The Agent2Agent protocol for MoonBit: agent cards, tasks, streaming and push notifications, as client and server."

source = "src"

import {
  "moonbitlang/async@0.22.5",
  "moonbitstack/moondate@0.1.7",
  "moonbitstack/moonasgi@0.11.2",
  "moonbitstack/moonfetch@0.2.0",
  "moonbitstack/moonhttp@0.16.0",
  "moonbitstack/moonjrpc@0.2.0",
  "moonbitstack/moonseed@0.2.0",
  "moonbitstack/moontel@0.2.2",
  "moonbitstack/moonbase@0.5.0",
  "moonbitstack/moonjson@0.5.0",
  "moonbitstack/moonurl@0.3.0",
  "moonbitstack/moonrpc@0.22.2",
  "moonbitstack/moonproto@0.2.0",
  "moonbitstack/moontls@0.9.17",
}
