name = "moonbitstack/moona2a"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moona2a"

license = "Apache-2.0"

keywords = [
  "a2a",
  "agent2agent",
  "agent",
  "agents",
  "protocol",
  "json-rpc",
  "jsonrpc",
  "sse",
  "server-sent-events",
  "agent-card",
  "well-known",
  "task",
  "artifact",
  "streaming",
  "push-notification",
  "webhook",
  "multi-agent",
  "interop",
  "moonbit",
]

description = "The Agent2Agent protocol for MoonBit: agent cards, tasks, streaming and push notifications, as client and server."

source = "src"

import {
  "moonbitlang/async@0.22.5",
  "moonbitstack/moondate@0.1.4",
  "moonbitstack/moonasgi@0.10.6",
  "moonbitstack/moonfetch@0.1.5",
  "moonbitstack/moonhttp@0.15.8",
  "moonbitstack/moonjrpc@0.1.3",
}
