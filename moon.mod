name = "moonbitstack/moona2a"

version = "0.1.1"

readme = "README.md"

repository = "https://github.com/moonbitstack/moona2a"

license = "Apache-2.0"

keywords = [
  "a2a",
  "agent2agent",
  "agent",
  "agents",
  "protocol",
  "json-rpc",
  "jsonrpc",
  "sse",
  "server-sent-events",
  "agent-card",
  "well-known",
  "task",
  "artifact",
  "streaming",
  "push-notification",
  "webhook",
  "multi-agent",
  "interop",
  "opentelemetry",
  "otel",
  "otlp",
  "tracing",
  "telemetry",
  "observability",
  "span",
  "gen-ai",
  "semantic-conventions",
  "request-headers",
  "headers",
  "traceparent",
  "w3c-trace-context",
  "context-propagation",
  "concurrency",
  "multi-task",
  "moonbit",
]

description = "The Agent2Agent protocol for MoonBit: agent cards, tasks, streaming and push notifications, as client and server."

source = "src"

import {
  "moonbitlang/async@0.22.5",
  "moonbitstack/moondate@0.1.6",
  "moonbitstack/moonasgi@0.10.8",
  "moonbitstack/moonfetch@0.1.8",
  "moonbitstack/moonhttp@0.15.10",
  "moonbitstack/moonjrpc@0.1.4",
  "moonbitstack/moonseed@0.1.3",
  "moonbitstack/moontel@0.1.2",
}
